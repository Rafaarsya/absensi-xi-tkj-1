# Salin menjadi .env lalu isi. JANGAN commit .env ke repositori.

# production | development. Di development cookie tidak diwajibkan HTTPS (agar bisa dites lewat http://localhost).
APP_ENV=production

# Wajib di production, minimal 32 karakter acak. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Kunci akses tambahan untuk login Admin (Ketua Kelas, Sekretaris, Wali Kelas).
# Hanya dibaca server, tidak pernah dikirim ke browser.
ADMIN_ACCESS_KEY=

# Lokasi berkas database SQLite (bawaan: instance/absensi.db). Pastikan di penyimpanan PERMANEN.
# DATABASE_PATH=/home/USERNAME/absensi/instance/absensi.db

# Isi 1 bila aplikasi berada di belakang satu reverse proxy (mis. PythonAnywhere/nginx) agar IP klien terbaca benar.
TRUST_PROXY=0

# Opsional
# COOKIE_SECURE=1
# SESSION_IDLE_MINUTES=120
# SCHOOL_NAME=SMKN 8 Kota Bekasi
# CLASS_NAME=XI TKJ 1
